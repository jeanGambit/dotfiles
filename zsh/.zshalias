alias zsh="$EDITOR $HOME/.zshrc && source $HOME/.zshrc"

# system
alias off="sudo shutdown now"

# Open Files with Extensions ---------------------------------
alias v="nvim"
# Open text files in NeoVim
alias -s txt="nvim"

# GNU core
# ls
alias ll="ls -l"
alias la="ls -la"
# cp
alias cp="cp -v "
# mv
alias mv="mv -v "
# Programs

# Languages
## java
## c
## python
