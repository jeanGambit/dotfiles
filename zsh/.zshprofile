# Load Order:
# .zenv -> [.zprofile] -> .zshrc -> .zlogin. -> .zlogout
# Add to this file exports of programs HOMEs.
# PATH, agents, session-wide exports

# Apps ==================================================
# Distrobox
export DISTROBOX_BACKEND=podman

# ROCm
export HSA_OVERRIDE_GFX_VERSION=10.3.0

# Languages =============================================
# Rust
[ -f "$XDG_CONFIG_HOME/cargo/env" ] && . "$XDG_CONFIG_HOME/cargo/env"

# Python (pyenv)
export PYENV_ROOT="$XDG_DATA_HOME/pyenv"
export PATH="$PYENV_ROOT/bin:$PATH"
if command -v pyenv 1>/dev/null 2>&1; then
  eval "$(pyenv init --path)"
fi

# Java (SDKMAN!)
export SDKMAN_DIR="$XDG_DATA_HOME/sdkman"
export PATH="$SDKMAN_DIR/bin:$PATH"
[[ -s "$SDKMAN_DIR/bin/sdkman-init.sh" ]] && source "$SDKMAN_DIR/bin/sdkman-init.sh"
