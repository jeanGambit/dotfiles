palette:
  black: '#262B44'
  blue: '#4B95E9'
  green: '#36A259'
  orange: '#F07623'
  red: '#D81E5B'
  white: '#E0DEF4'
  yellow: '#F3AE35'
  purple: '#6D006A'

blocks:
  - type: prompt
    alignment: left
    filler: ⎯
    overflow: hide
    segments:
      - type: path
        style: powerline
        powerline_symbol: 
        foreground: "#ffffff"
        background: "#61AFEF"
        template: " {{ .Path }} "

  - type: prompt
    newline: true
    segments: 
      - type: text
        style: plain
        template: "❯ "

